# Rust build output
/target/

# Dataset (download with scripts/download_data.sh; `expand` output goes here too)
/data/*
!/data/README.md
!/data/.gitkeep

# Sample images written by `export-samples`
/samples/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC debug info, cargo-mutants output, rustc ICE dumps
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
